# Get one at https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "API Read Access Token" works.
TMDB_API_KEY=

# Optional cloud sync (Supabase). From your project's Settings -> API Keys / Data API:
VITE_SUPABASE_URL=
# The publishable (or legacy "anon") key; it's public by design.
VITE_SUPABASE_KEY=
# Only for npm run db:migrate: a personal access token from
# https://supabase.com/dashboard/account/tokens (never committed).
SUPABASE_ACCESS_TOKEN=
